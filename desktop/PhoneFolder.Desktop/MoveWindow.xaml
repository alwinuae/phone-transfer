<Window x:Class="PhoneFolder.Desktop.MoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PhoneFolder.Desktop.Models"
        Title="Choose destination folder"
        Style="{StaticResource {x:Type Window}}"
        Width="480"
        Height="560"
        MinWidth="380"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="InstructionText"
                   Margin="0,0,0,12"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Choose the destination folder"/>
        <Border Grid.Row="1"
                Padding="8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <TreeView x:Name="FolderTree"
                      ItemsSource="{Binding}"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      TreeViewItem.Expanded="FolderTreeItem_Expanded">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}"/>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DestinationText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Select a folder"/>
            <Button Grid.Column="1" IsCancel="True" Content="Cancel"/>
            <Button x:Name="ConfirmButton"
                    Grid.Column="2"
                    Click="ConfirmButton_Click"
                    Content="Move here"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>
