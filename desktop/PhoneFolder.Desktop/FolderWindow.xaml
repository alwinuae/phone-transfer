<Window x:Class="PhoneFolder.Desktop.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Transfer - Folder"
        Icon="/PhoneTransfer;component/Assets/PhoneTransfer.ico"
        Style="{StaticResource {x:Type Window}}"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="440"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12,10,4,4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <UniformGrid x:Name="FolderNavigationPanel"
                             Rows="1">
                    <Button x:Name="BackButton"
                            Click="BackButton_Click"
                            Content="&lt; Back"
                            Style="{StaticResource NavigationButton}"/>
                    <Button x:Name="UpButton"
                            Click="UpButton_Click"
                            Content="^ Up"
                            Style="{StaticResource NavigationButton}"/>
                    <Button Click="RefreshButton_Click"
                            Content="Refresh"
                            Style="{StaticResource NavigationButton}"/>
                </UniformGrid>
                <TextBlock x:Name="PathText"
                           Grid.Row="1"
                           Margin="2,2,8,6"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Padding="12,10,4,2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <UniformGrid x:Name="FolderActionsPanel"
                         Rows="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource ResponsiveToolbarButton}"/>
                </UniformGrid.Resources>
                <Button Click="UploadButton_Click" Content="Upload files"/>
                <Button x:Name="DownloadButton"
                        Click="DownloadButton_Click"
                        Content="Download"/>
                <Button x:Name="CopyButton"
                        Click="CopyButton_Click"
                        Content="Copy"/>
                <Button x:Name="CutButton"
                        Click="CutButton_Click"
                        Content="Cut"/>
                <Button x:Name="PasteButton"
                        Click="PasteButton_Click"
                        Content="Paste"/>
                <Button x:Name="CopyToButton"
                        Click="CopyToButton_Click"
                        Content="Copy to..."/>
                <Button x:Name="MoveToButton"
                        Click="MoveToButton_Click"
                        Content="Move to"/>
                <Button x:Name="RenameButton"
                        Click="RenameButton_Click"
                        Content="Rename"/>
                <Button x:Name="DeleteButton"
                        Click="DeleteButton_Click"
                        Content="Delete"/>
                <Button Click="OpenFolderWindowButton_Click" Content="Open another window"/>
                <Button Click="TransfersButton_Click" Content="Transfers"/>
                <Button x:Name="ViewModeButton"
                        Click="ViewModeButton_Click"
                        Content="View: Details"
                        ToolTip="Ctrl+1 through Ctrl+6 changes the file view">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="ViewDetails_Click" Header="Details"/>
                            <MenuItem Click="ViewList_Click" Header="List"/>
                            <MenuItem Click="ViewTiles_Click" Header="Tiles"/>
                            <MenuItem Click="ViewSmallIcons_Click" Header="Small icons"/>
                            <MenuItem Click="ViewMediumIcons_Click" Header="Medium icons"/>
                            <MenuItem Click="ViewLargeIcons_Click" Header="Large icons"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="SortModeButton"
                        Click="SortModeButton_Click"
                        Content="Sort: Name"
                        ToolTip="Sort files and folders">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="SortName_Click" Header="Name"/>
                            <MenuItem Click="SortModified_Click" Header="Date modified"/>
                            <MenuItem Click="SortType_Click" Header="Type"/>
                            <MenuItem Click="SortSize_Click" Header="Size"/>
                            <Separator/>
                            <MenuItem Click="SortAscending_Click" Header="Ascending"/>
                            <MenuItem Click="SortDescending_Click" Header="Descending"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2"
              AllowDrop="True"
              DragOver="Files_DragOver"
              DragLeave="Files_DragLeave"
              Drop="Files_Drop">
            <Grid.Resources>
                <ContextMenu x:Key="FolderItemsContextMenu" x:Shared="False">
                    <MenuItem Click="OpenMenuItem_Click" Header="Open"/>
                    <MenuItem Click="DownloadButton_Click" Header="Download"/>
                    <Separator/>
                    <MenuItem Click="CopyButton_Click" Header="Copy"/>
                    <MenuItem Click="CutButton_Click" Header="Cut"/>
                    <MenuItem Click="PasteButton_Click" Header="Paste"/>
                    <MenuItem Click="CopyToButton_Click" Header="Copy to..."/>
                    <MenuItem Click="MoveToButton_Click" Header="Move to"/>
                    <MenuItem Click="RenameButton_Click" Header="Rename"/>
                    <MenuItem Click="DeleteButton_Click" Header="Delete"/>
                    <Separator/>
                    <MenuItem Click="RefreshButton_Click" Header="Refresh"/>
                    <MenuItem Header="Sort by">
                        <MenuItem Click="SortName_Click" Header="Name"/>
                        <MenuItem Click="SortModified_Click" Header="Date modified"/>
                        <MenuItem Click="SortType_Click" Header="Type"/>
                        <MenuItem Click="SortSize_Click" Header="Size"/>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Click="ViewDetails_Click" Header="Details"/>
                        <MenuItem Click="ViewList_Click" Header="List"/>
                        <MenuItem Click="ViewTiles_Click" Header="Tiles"/>
                        <MenuItem Click="ViewSmallIcons_Click" Header="Small icons"/>
                        <MenuItem Click="ViewMediumIcons_Click" Header="Medium icons"/>
                        <MenuItem Click="ViewLargeIcons_Click" Header="Large icons"/>
                    </MenuItem>
                </ContextMenu>
            </Grid.Resources>
            <DataGrid x:Name="FilesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      MouseDoubleClick="Files_MouseDoubleClick"
                      PreviewMouseMove="Files_PreviewMouseMove"
                      SelectionChanged="Files_SelectionChanged"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      Style="{StaticResource CompactDataGrid}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="OpenMenuItem"
                                  Click="OpenMenuItem_Click"
                                  Header="Open"/>
                        <Separator/>
                        <MenuItem x:Name="CopyMenuItem"
                                  Click="CopyButton_Click"
                                  Header="Copy"/>
                        <MenuItem x:Name="CutMenuItem"
                                  Click="CutButton_Click"
                                  Header="Cut"/>
                        <MenuItem x:Name="PasteMenuItem"
                                  Click="PasteButton_Click"
                                  Header="Paste"/>
                        <MenuItem x:Name="CopyToMenuItem"
                                  Click="CopyToButton_Click"
                                  Header="Copy to..."/>
                        <MenuItem x:Name="MoveToMenuItem"
                                  Click="MoveToButton_Click"
                                  Header="Move to"/>
                        <MenuItem x:Name="RenameMenuItem"
                                  Click="RenameButton_Click"
                                  Header="Rename"/>
                        <Separator/>
                        <MenuItem x:Name="DeleteMenuItem"
                                  Click="DeleteButton_Click"
                                  Header="Delete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="38" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="ItemCheckBox"
                                          AutomationProperties.Name="{Binding Name}"
                                          Click="ItemCheckBox_Click"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" IsReadOnly="True"/>
                    <DataGridTextColumn Width="140" Binding="{Binding TypeLabel}" Header="Type" IsReadOnly="True"/>
                    <DataGridTextColumn Width="100" Binding="{Binding SizeLabel}" Header="Size" IsReadOnly="True"/>
                    <DataGridTextColumn Width="155" Binding="{Binding ModifiedLabel}" Header="Modified" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <ListBox x:Name="FilesList"
                     ContextMenu="{StaticResource FolderItemsContextMenu}"
                     Visibility="Collapsed"
                     MouseDoubleClick="Files_MouseDoubleClick"
                     PreviewMouseMove="Files_PreviewMouseMove"
                     SelectionChanged="Files_SelectionChanged"
                     SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="30" Margin="3,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ItemCheckBox"
                                      AutomationProperties.Name="{Binding Name}"
                                      Click="ItemCheckBox_Click"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding TypeLabel}"/>
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SizeLabel}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="ThumbnailList"
                     ContextMenu="{StaticResource FolderItemsContextMenu}"
                     Visibility="Collapsed"
                     MouseDoubleClick="Files_MouseDoubleClick"
                     PreviewMouseMove="Files_PreviewMouseMove"
                     SelectionChanged="Files_SelectionChanged"
                     SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="142"
                                Height="164"
                                Margin="5"
                                Padding="7"
                                Background="{StaticResource PanelRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="105"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <CheckBox HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Panel.ZIndex="2"
                                          AutomationProperties.AutomationId="ItemCheckBox"
                                          AutomationProperties.Name="{Binding Name}"
                                          Click="ItemCheckBox_Click"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid>
                                    <Path Width="48"
                                          Height="61"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="#8C9294"
                                          Stretch="Fill"
                                          Data="M5,1 L34,1 L49,16 L49,63 L5,63 Z M34,1 L34,16 L49,16">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Width="67"
                                          Height="50"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="#D99A3E"
                                          Stretch="Fill"
                                          Data="M2,8 L29,8 L38,18 L78,18 L78,62 L2,62 Z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Image Margin="3"
                                           Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"/>
                                    <Border Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#CC181A1B"
                                            CornerRadius="16">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Width="11"
                                              Height="13"
                                              Margin="3,0,0,0"
                                              Fill="White"
                                              Stretch="Fill"
                                              Data="M0,0 L12,7 L0,14 Z"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding SizeLabel}"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="DropHint"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="Drop PC files or copied phone items here"/>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="4,10,4,0"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Ready"/>
    </Grid>
</Window>
