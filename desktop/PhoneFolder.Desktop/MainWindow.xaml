<Window x:Class="PhoneFolder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PhoneFolder.Desktop.Models"
        Title="Phone Transfer"
        Icon="Assets/PhoneTransfer.ico"
        Style="{StaticResource {x:Type Window}}"
        Width="1380"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ConnectionColumn" Width="330"/>
            <ColumnDefinition x:Name="ConnectionToggleColumn" Width="38"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ConnectionPane"
                Grid.Column="0"
                Padding="22"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Grid.RowSpan="4"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <StackPanel Margin="0,0,0,22" Orientation="Horizontal">
                        <Image Width="62"
                               Height="62"
                               Margin="0,0,12,0"
                               Source="Assets/PhoneTransfer.png"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="26" FontWeight="Bold" Text="Phone Transfer"/>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Fast Android file transfer"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Trusted phones"/>
                    <ComboBox x:Name="TrustedDevicesCombo"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="TrustedDevicesCombo_SelectionChanged"/>
                    <Button x:Name="SwitchDeviceButton"
                            Margin="0,8,0,12"
                            Click="SwitchDeviceButton_Click"
                            Content="Connect trusted phone"
                            Style="{StaticResource PrimaryButton}"/>

                    <Expander x:Name="SetupExpander"
                              Margin="0,4,0,0"
                              Header="Setup and connection">
                        <StackPanel Margin="0,12,0,0">
                            <Border Margin="0,0,0,12"
                                    Padding="12"
                                    Background="{StaticResource PanelRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="Router Wi-Fi"/>
                                    <TextBlock Margin="0,3,0,9"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Use when the PC and phone share the same Wi-Fi router."
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="DiscoverButton"
                                            Margin="0,0,0,8"
                                            Click="DiscoverButton_Click"
                                            Content="Find phones on router Wi-Fi"/>
                                    <ComboBox x:Name="DiscoveredDevicesCombo"
                                              Margin="0,0,0,8"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="DiscoveredDevicesCombo_SelectionChanged"/>
                                    <Button x:Name="ConnectDiscoveredButton"
                                            Click="ConnectDiscoveredButton_Click"
                                            Content="Connect selected Wi-Fi phone"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,12"
                                    Padding="12"
                                    Background="{StaticResource PanelRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="PC hotspot (direct Wi-Fi)"/>
                                    <TextBlock Margin="0,3,0,9"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Connect the phone to Windows Mobile Hotspot for a direct local link."
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="OpenHotspotSettingsButton"
                                            Margin="0,0,0,8"
                                            Click="OpenHotspotSettingsButton_Click"
                                            Content="Open hotspot settings"/>
                                    <Button x:Name="HotspotButton"
                                            Click="HotspotButton_Click"
                                            Content="Find phone on PC hotspot"/>
                                </StackPanel>
                            </Border>

                            <Expander Header="Manual address">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Text="Phone address"/>
                                    <TextBox x:Name="HostTextBox"
                                             Margin="0,0,0,12"
                                             Text="192.168.1.2"/>
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Text="Port"/>
                                    <TextBox x:Name="PortTextBox"
                                             Margin="0,0,0,12"
                                             Text="8765"/>
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Text="Access code"/>
                                    <TextBox x:Name="TokenTextBox"
                                             Margin="0,0,0,12"
                                             MaxLength="12"/>
                                    <CheckBox x:Name="RememberDeviceCheckBox"
                                              IsChecked="True"
                                              Content="Trust this PC for future connections"
                                              ToolTip="A cryptographic trusted-device token is stored securely in Windows Credential Manager"/>
                                    <Button x:Name="ConnectButton"
                                            Margin="0,14,0,0"
                                            Click="ConnectButton_Click"
                                            Content="Connect using address"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Expander>

                            <Button x:Name="ForgetDeviceButton"
                                    Margin="0,8,0,0"
                                    Click="ForgetDeviceButton_Click"
                                    Content="Manage trusted phones"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="ConnectionStatusText"
                               Margin="0,16,0,4"
                               FontWeight="SemiBold"
                               Text="Not connected"/>
                    <TextBlock x:Name="DeviceDetailsText"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="StorageStatusText"
                               Margin="0,12,0,5"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <ProgressBar x:Name="StorageUsageBar"
                                 Height="18"
                                 Maximum="100"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="ConnectionPaneToggle"
                Grid.Column="1"
                Width="30"
                Height="48"
                Margin="4,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ConnectionPaneToggle_Click"
                Content="&lt;"
                ToolTip="Collapse connection panel"/>

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="14,8,6,8"
                        Background="{StaticResource TitleBarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <UniformGrid x:Name="FileActionsPanel"
                                     IsEnabled="False"
                                     Rows="1">
                            <UniformGrid.Resources>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource ResponsiveToolbarButton}"/>
                            </UniformGrid.Resources>
                            <Button x:Name="OpenMediaButton"
                                    Click="OpenMediaButton_Click"
                                    Content="Open"
                                    ToolTip="Open the selected file (Enter)"/>
                            <Button Click="UploadButton_Click"
                                    Content="Upload files"
                                    ToolTip="Upload files from this PC"/>
                            <Button Click="UploadFolderButton_Click"
                                    Content="Upload folder"
                                    ToolTip="Upload a folder from this PC"/>
                            <Button x:Name="DownloadButton"
                                    Click="DownloadButton_Click"
                                    Content="Download"
                                    ToolTip="Download selected items"/>
                            <Button Click="NewFolderButton_Click"
                                    Content="New folder"
                                    ToolTip="Create a folder"/>
                            <Button x:Name="OpenFolderWindowButton"
                                    Click="OpenFolderWindowButton_Click"
                                    Content="Open in new tab"
                                    ToolTip="Keep the current or selected folder open in another tab"/>
                            <Button x:Name="CopySelectionButton"
                                    Click="CopySelectionButton_Click"
                                    Content="Copy"
                                    ToolTip="Copy checked items (Ctrl+C)"/>
                            <Button x:Name="CutSelectionButton"
                                    Click="CutSelectionButton_Click"
                                    Content="Cut"
                                    ToolTip="Cut checked items (Ctrl+X)"/>
                            <Button x:Name="PasteButton"
                                    Click="PasteButton_Click"
                                    Content="Paste"
                                    ToolTip="Paste into this folder (Ctrl+V)"/>
                            <Button x:Name="CopyToButton"
                                    Click="CopyButton_Click"
                                    Content="Copy to..."
                                    ToolTip="Copy all selected items to another phone folder"/>
                            <Button x:Name="MoveToButton"
                                    Click="MoveButton_Click"
                                    Content="Move to"
                                    ToolTip="Move all selected items"/>
                            <Button x:Name="RenameButton"
                                    Click="RenameButton_Click"
                                    Content="Rename"
                                    ToolTip="Rename the selected item"/>
                            <Button x:Name="DeleteButton"
                                    Click="DeleteButton_Click"
                                    Content="Delete"
                                    ToolTip="Delete selected items (Delete)"/>
                            <Button x:Name="FolderPaneButton"
                                    Click="FolderPaneButton_Click"
                                    Content="Folders: On"
                                    ToolTip="Show or hide the resizable folder navigation pane"/>
                            <Button x:Name="ViewModeButton"
                                    Click="ViewModeButton_Click"
                                    Content="View: Details"
                                    ToolTip="Change view (Ctrl+1 through Ctrl+6)">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="ViewDetails_Click" Header="Details"/>
                                        <MenuItem Click="ViewList_Click" Header="List"/>
                                        <MenuItem Click="ViewTiles_Click" Header="Tiles"/>
                                        <MenuItem Click="ViewSmallIcons_Click" Header="Small icons"/>
                                        <MenuItem Click="ViewMediumIcons_Click" Header="Medium icons"/>
                                        <MenuItem Click="ViewLargeIcons_Click" Header="Large icons"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="SortModeButton"
                                    Click="SortModeButton_Click"
                                    Content="Sort: Name"
                                    ToolTip="Sort files and folders">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="SortName_Click" Header="Name"/>
                                        <MenuItem Click="SortModified_Click" Header="Date modified"/>
                                        <MenuItem Click="SortType_Click" Header="Type"/>
                                        <MenuItem Click="SortSize_Click" Header="Size"/>
                                        <Separator/>
                                        <MenuItem Click="SortAscending_Click" Header="Ascending"/>
                                        <MenuItem Click="SortDescending_Click" Header="Descending"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </UniformGrid>
                </Border>

                <Border Grid.Row="1"
                        Padding="14,10,6,6"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <UniformGrid x:Name="MainHeaderButtonsPanel"
                                     Rows="1">
                            <Button x:Name="BackButton"
                                    IsEnabled="False"
                                    Click="BackButton_Click"
                                    Content="&lt; Back"
                                    Style="{StaticResource NavigationButton}"/>
                            <Button x:Name="UpButton"
                                    IsEnabled="False"
                                    Click="UpButton_Click"
                                    Content="^ Up"
                                    Style="{StaticResource NavigationButton}"/>
                            <Button x:Name="RefreshButton"
                                    IsEnabled="False"
                                    Click="RefreshButton_Click"
                                    Content="Refresh"
                                    Style="{StaticResource NavigationButton}"/>
                            <Button x:Name="DisconnectButton"
                                    IsEnabled="False"
                                    Click="DisconnectButton_Click"
                                    Content="Not connected"
                                    Style="{StaticResource DisconnectedButton}"/>
                            <Button x:Name="SettingsButton"
                                    Click="SettingsButton_Click"
                                    AutomationProperties.Name="Setup"
                                    ToolTip="Application setup"
                                    Style="{StaticResource ResponsiveToolbarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="18"
                                               Height="18"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="16"
                                               Text="&#xE713;"
                                               TextAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" Text="Setup"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TransfersButton"
                                    Click="TransfersButton_Click"
                                    Content="Transfers"
                                    Style="{StaticResource ResponsiveToolbarButton}"/>
                        </UniformGrid>
                        <TextBlock x:Name="PathText"
                                   Grid.Row="1"
                                   Margin="2,7,8,2"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Connect to a phone to browse files"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="12,0,10,0"
                        Background="{StaticResource WindowBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <ListBox x:Name="FolderTabsList"
                             AutomationProperties.Name="Open phone folders"
                             ItemContainerStyle="{StaticResource BrowserTabItem}"
                             SelectionChanged="FolderTabsList_SelectionChanged"
                             Style="{StaticResource BrowserTabsList}"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="14"
                                          Height="11"
                                          VerticalAlignment="Center"
                                          Fill="#E6A23C"
                                          Stretch="Fill"
                                          Data="M1,3 L7,3 L9,6 L19,6 L19,16 L1,16 Z"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="6,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PathLabel}"/>
                                    <Button Grid.Column="2"
                                            Width="22"
                                            Height="22"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Margin="0"
                                            Padding="0"
                                            Click="CloseFolderTabButton_Click"
                                            Content="&#xE8BB;"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="9"
                                            Style="{StaticResource CompactToolbarButton}"
                                            Tag="{Binding}"
                                            ToolTip="Close tab"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FolderColumn" Width="220" MinWidth="120"/>
                        <ColumnDefinition x:Name="FolderSplitterColumn" Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="FolderPane"
                            Grid.Column="0"
                            Padding="8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="8,4,8,8"
                                       FontWeight="SemiBold"
                                       Text="Folders"/>
                            <TreeView x:Name="FolderTree"
                                      Background="{StaticResource PanelBrush}"
                                      ItemsSource="{Binding}"
                                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                                      TreeViewItem.Expanded="FolderTreeItem_Expanded">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17"
                                                  Height="14"
                                                  Margin="0,0,7,0"
                                                  Fill="#E6A23C"
                                                  Stretch="Fill"
                                                  Data="M1,3 L7,3 L9,6 L19,6 L19,16 L1,16 Z"/>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <GridSplitter x:Name="FolderSplitter"
                                  Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource ControlBrush}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"
                                  ShowsPreview="True"/>

                    <Grid x:Name="FilesHost"
                          Grid.Column="2"
                          Margin="10"
                          AllowDrop="True"
                          DragOver="FilesHost_DragOver"
                          DragLeave="FilesHost_DragLeave"
                          Drop="FilesHost_Drop">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="OpenContext_Click" Header="Open"/>
                                <MenuItem Click="DownloadButton_Click" Header="Download"/>
                                <Separator/>
                                <MenuItem Click="CopySelectionButton_Click" Header="Copy"/>
                                <MenuItem Click="CutSelectionButton_Click" Header="Cut"/>
                                <MenuItem Click="PasteButton_Click" Header="Paste"/>
                                <MenuItem Click="CopyButton_Click" Header="Copy to..."/>
                                <MenuItem Click="MoveButton_Click" Header="Move to"/>
                                <MenuItem Click="RenameButton_Click" Header="Rename"/>
                                <MenuItem Click="DeleteButton_Click" Header="Delete"/>
                                <Separator/>
                                <MenuItem Click="RefreshButton_Click" Header="Refresh"/>
                                <MenuItem Header="Sort by">
                                    <MenuItem Click="SortName_Click" Header="Name"/>
                                    <MenuItem Click="SortModified_Click" Header="Date modified"/>
                                    <MenuItem Click="SortType_Click" Header="Type"/>
                                    <MenuItem Click="SortSize_Click" Header="Size"/>
                                </MenuItem>
                                <MenuItem Header="View">
                                    <MenuItem Click="ViewDetails_Click" Header="Details"/>
                                    <MenuItem Click="ViewList_Click" Header="List"/>
                                    <MenuItem Click="ViewTiles_Click" Header="Tiles"/>
                                    <MenuItem Click="ViewSmallIcons_Click" Header="Small icons"/>
                                    <MenuItem Click="ViewMediumIcons_Click" Header="Medium icons"/>
                                    <MenuItem Click="ViewLargeIcons_Click" Header="Large icons"/>
                                </MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <DataGrid x:Name="FilesGrid"
                                  AutoGenerateColumns="False"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="Items_MouseDoubleClick"
                                  PreviewMouseMove="Items_PreviewMouseMove"
                                  SelectionChanged="Items_SelectionChanged"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource CompactDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42" Header="" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.AutomationId="ItemCheckBox"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      Click="ItemCheckBox_Click"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" IsReadOnly="True"/>
                                <DataGridTextColumn Width="150" Binding="{Binding TypeLabel}" Header="Type" IsReadOnly="True"/>
                                <DataGridTextColumn Width="110" Binding="{Binding SizeLabel}" Header="Size" IsReadOnly="True"/>
                                <DataGridTextColumn Width="170" Binding="{Binding ModifiedLabel}" Header="Modified" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ListBox x:Name="FilesList"
                                 Visibility="Collapsed"
                                 MouseDoubleClick="Items_MouseDoubleClick"
                                 PreviewMouseMove="Items_PreviewMouseMove"
                                 SelectionChanged="Items_SelectionChanged"
                                 SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="34" Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="ItemCheckBox"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  Click="ItemCheckBox_Click"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding TypeLabel}"/>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding SizeLabel}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="ThumbnailList"
                                 Visibility="Collapsed"
                                 ItemTemplate="{StaticResource FileLargeIconTemplate}"
                                 MouseDoubleClick="Items_MouseDoubleClick"
                                 PreviewMouseMove="Items_PreviewMouseMove"
                                 SelectionChanged="Items_SelectionChanged"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Border x:Name="DropHint"
                                Margin="20"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelRaisedBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="Drop files or folders to copy them here"/>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="4"
                        Padding="18,12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock x:Name="OperationStatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Ready"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
