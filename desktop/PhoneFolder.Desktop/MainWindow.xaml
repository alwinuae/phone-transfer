<Window x:Class="PhoneFolder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PhoneFolder.Desktop.Models"
        Title="Phone Transfer"
        Icon="Assets/PhoneTransfer.ico"
        Width="1380"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ConnectionColumn" Width="330"/>
            <ColumnDefinition x:Name="ConnectionToggleColumn" Width="38"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="ConnectionPane"
                Grid.Column="0"
                Padding="22"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Grid.RowSpan="4"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <StackPanel Margin="0,0,0,22" Orientation="Horizontal">
                        <Image Width="62"
                               Height="62"
                               Margin="0,0,12,0"
                               Source="Assets/PhoneTransfer.png"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="26" FontWeight="Bold" Text="Phone Transfer"/>
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Fast Android file transfer"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Trusted phones"/>
                    <ComboBox x:Name="TrustedDevicesCombo"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="TrustedDevicesCombo_SelectionChanged"/>
                    <Button x:Name="SwitchDeviceButton"
                            Margin="0,8,0,12"
                            Click="SwitchDeviceButton_Click"
                            Content="Connect trusted phone"
                            Style="{StaticResource PrimaryButton}"/>

                    <Expander x:Name="SetupExpander"
                              Margin="0,4,0,0"
                              Header="Setup and connection">
                        <StackPanel Margin="0,12,0,0">
                            <Border Margin="0,0,0,12"
                                    Padding="12"
                                    Background="#F7FAFE"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="Router Wi-Fi"/>
                                    <TextBlock Margin="0,3,0,9"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Use when the PC and phone share the same Wi-Fi router."
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="DiscoverButton"
                                            Margin="0,0,0,8"
                                            Click="DiscoverButton_Click"
                                            Content="Find phones on router Wi-Fi"/>
                                    <ComboBox x:Name="DiscoveredDevicesCombo"
                                              Margin="0,0,0,8"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="DiscoveredDevicesCombo_SelectionChanged"/>
                                    <Button x:Name="ConnectDiscoveredButton"
                                            Click="ConnectDiscoveredButton_Click"
                                            Content="Connect selected Wi-Fi phone"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,12"
                                    Padding="12"
                                    Background="#F7FAFE"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="PC hotspot (direct Wi-Fi)"/>
                                    <TextBlock Margin="0,3,0,9"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Connect the phone to Windows Mobile Hotspot for a direct local link."
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="OpenHotspotSettingsButton"
                                            Margin="0,0,0,8"
                                            Click="OpenHotspotSettingsButton_Click"
                                            Content="Open hotspot settings"/>
                                    <Button x:Name="HotspotButton"
                                            Click="HotspotButton_Click"
                                            Content="Find phone on PC hotspot"/>
                                </StackPanel>
                            </Border>

                            <Expander Header="Manual address">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Text="Phone address"/>
                                    <TextBox x:Name="HostTextBox"
                                             Margin="0,0,0,12"
                                             Text="192.168.1.2"/>
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Text="Port"/>
                                    <TextBox x:Name="PortTextBox"
                                             Margin="0,0,0,12"
                                             Text="8765"/>
                                    <TextBlock Margin="0,0,0,6"
                                               FontWeight="SemiBold"
                                               Text="Access code"/>
                                    <TextBox x:Name="TokenTextBox"
                                             Margin="0,0,0,12"
                                             MaxLength="12"/>
                                    <CheckBox x:Name="RememberDeviceCheckBox"
                                              IsChecked="True"
                                              Content="Trust this PC for future connections"
                                              ToolTip="A cryptographic trusted-device token is stored securely in Windows Credential Manager"/>
                                    <Button x:Name="ConnectButton"
                                            Margin="0,14,0,0"
                                            Click="ConnectButton_Click"
                                            Content="Connect using address"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Expander>

                            <Button x:Name="ForgetDeviceButton"
                                    Margin="0,8,0,0"
                                    Click="ForgetDeviceButton_Click"
                                    Content="Manage trusted phones"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="ConnectionStatusText"
                               Margin="0,16,0,4"
                               FontWeight="SemiBold"
                               Text="Not connected"/>
                    <TextBlock x:Name="DeviceDetailsText"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="ConnectionPaneToggle"
                Grid.Column="1"
                Width="30"
                Height="48"
                Margin="4,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ConnectionPaneToggle_Click"
                Content="&lt;"
                ToolTip="Collapse connection panel"/>

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton"
                                IsEnabled="False"
                                Click="BackButton_Click"
                                Content="&lt; Back"
                                Style="{StaticResource NavigationButton}"/>
                        <Button x:Name="UpButton"
                                Grid.Column="1"
                                IsEnabled="False"
                                Click="UpButton_Click"
                                Content="^ Up"
                                Style="{StaticResource NavigationButton}"/>
                        <Button x:Name="RefreshButton"
                                Grid.Column="2"
                                IsEnabled="False"
                                Click="RefreshButton_Click"
                                Content="Refresh"
                                Style="{StaticResource NavigationButton}"/>
                        <TextBlock x:Name="PathText"
                                   Grid.Column="3"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Connect to a phone to browse files"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="DisconnectButton"
                                Grid.Column="4"
                                IsEnabled="False"
                                Click="DisconnectButton_Click"
                                Content="Not connected"
                                Style="{StaticResource DisconnectedButton}"/>
                        <Button x:Name="SettingsButton"
                                Grid.Column="5"
                                Margin="4,0,0,0"
                                Padding="10,7"
                                Click="SettingsButton_Click"
                                ToolTip="Application setup">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Margin="0,0,7,0"
                                      Fill="{StaticResource TextBrush}"
                                      Stretch="Uniform"
                                      Data="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M9.6,2 L14.4,2 L15,4.3 L17,5.1 L19.1,4 L22,6.9 L20.9,9 L21.7,11 L24,11.6 L24,16.4 L21.7,17 L20.9,19 L22,21.1 L19.1,24 L17,22.9 L15,23.7 L14.4,26 L9.6,26 L9,23.7 L7,22.9 L4.9,24 L2,21.1 L3.1,19 L2.3,17 L0,16.4 L0,11.6 L2.3,11 L3.1,9 L2,6.9 L4.9,4 L7,5.1 L9,4.3 Z"/>
                                <TextBlock VerticalAlignment="Center" Text="Setup"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TransfersButton"
                                Grid.Column="6"
                                Margin="4,0,0,0"
                                Click="TransfersButton_Click"
                                Content="Transfers"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="ViewModeButton"
                                DockPanel.Dock="Right"
                                Margin="14,0,0,0"
                                Click="ViewModeButton_Click"
                                Content="View: Details"
                                ToolTip="Change view (Ctrl+1 Details, Ctrl+2 List, Ctrl+3 Thumbnails)">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="ViewDetails_Click" Header="Details"/>
                                    <MenuItem Click="ViewList_Click" Header="List"/>
                                    <MenuItem Click="ViewThumbnails_Click" Header="Thumbnails"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FolderPaneButton"
                                DockPanel.Dock="Right"
                                Margin="14,0,0,0"
                                Click="FolderPaneButton_Click"
                                Content="Folders: On"
                                ToolTip="Show or hide the resizable folder navigation pane"/>
                        <WrapPanel x:Name="FileActionsPanel" IsEnabled="False">
                            <Button x:Name="OpenMediaButton"
                                    Click="OpenMediaButton_Click"
                                    Content="Open"
                                    ToolTip="Open the selected file (Enter)"/>
                            <Button Click="UploadButton_Click" Content="Upload files" ToolTip="Upload files from this PC"/>
                            <Button Click="UploadFolderButton_Click" Content="Upload folder" ToolTip="Upload a folder from this PC"/>
                            <Button Click="DownloadButton_Click" Content="Download" ToolTip="Download selected items"/>
                            <Button Click="NewFolderButton_Click" Content="New folder" ToolTip="Create a folder"/>
                            <Button x:Name="OpenFolderWindowButton"
                                    Click="OpenFolderWindowButton_Click"
                                    Content="Open folder window"
                                    ToolTip="Open the current or selected folder in another window"/>
                            <Button x:Name="CopySelectionButton"
                                    Click="CopySelectionButton_Click"
                                    Content="Copy"
                                    ToolTip="Copy checked items (Ctrl+C)"/>
                            <Button x:Name="CutSelectionButton"
                                    Click="CutSelectionButton_Click"
                                    Content="Cut"
                                    ToolTip="Cut checked items (Ctrl+X)"/>
                            <Button x:Name="PasteButton"
                                    Click="PasteButton_Click"
                                    Content="Paste"
                                    ToolTip="Paste into this folder (Ctrl+V)"/>
                            <Button x:Name="CopyButton"
                                    Click="CopyButton_Click"
                                    Content="Copy to..."
                                    ToolTip="Copy all selected items to another phone folder"/>
                            <Button Click="MoveButton_Click" Content="Move to" ToolTip="Move all selected items"/>
                            <Button Click="RenameButton_Click" Content="Rename" ToolTip="Rename the selected item"/>
                            <Button Click="DeleteButton_Click" Content="Delete" ToolTip="Delete selected items (Delete)"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FolderColumn" Width="220" MinWidth="120"/>
                        <ColumnDefinition x:Name="FolderSplitterColumn" Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="FolderPane"
                            Grid.Column="0"
                            Padding="8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="8,4,8,8"
                                       FontWeight="SemiBold"
                                       Text="Folders"/>
                            <TreeView x:Name="FolderTree"
                                      ItemsSource="{Binding}"
                                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                                      TreeViewItem.Expanded="FolderTreeItem_Expanded">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17"
                                                  Height="14"
                                                  Margin="0,0,7,0"
                                                  Fill="#E6A23C"
                                                  Stretch="Fill"
                                                  Data="M1,3 L7,3 L9,6 L19,6 L19,16 L1,16 Z"/>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <GridSplitter x:Name="FolderSplitter"
                                  Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  Background="#E7EDF5"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"
                                  ShowsPreview="True"/>

                    <Grid x:Name="FilesHost"
                          Grid.Column="2"
                          Margin="10"
                          AllowDrop="True"
                          DragOver="FilesHost_DragOver"
                          DragLeave="FilesHost_DragLeave"
                          Drop="FilesHost_Drop">
                        <DataGrid x:Name="FilesGrid"
                                  AutoGenerateColumns="False"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="Items_MouseDoubleClick"
                                  PreviewMouseMove="Items_PreviewMouseMove"
                                  SelectionChanged="Items_SelectionChanged"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42" Header="" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.AutomationId="ItemCheckBox"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      Click="ItemCheckBox_Click"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" IsReadOnly="True"/>
                                <DataGridTextColumn Width="150" Binding="{Binding TypeLabel}" Header="Type" IsReadOnly="True"/>
                                <DataGridTextColumn Width="110" Binding="{Binding SizeLabel}" Header="Size" IsReadOnly="True"/>
                                <DataGridTextColumn Width="170" Binding="{Binding ModifiedLabel}" Header="Modified" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ListBox x:Name="FilesList"
                                 Visibility="Collapsed"
                                 MouseDoubleClick="Items_MouseDoubleClick"
                                 PreviewMouseMove="Items_PreviewMouseMove"
                                 SelectionChanged="Items_SelectionChanged"
                                 SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="34" Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="ItemCheckBox"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  Click="ItemCheckBox_Click"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding TypeLabel}"/>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding SizeLabel}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="ThumbnailList"
                                 Visibility="Collapsed"
                                 MouseDoubleClick="Items_MouseDoubleClick"
                                 PreviewMouseMove="Items_PreviewMouseMove"
                                 SelectionChanged="Items_SelectionChanged"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150" Height="174" Margin="6" Padding="8"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="112"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <CheckBox HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Panel.ZIndex="2"
                                                      AutomationProperties.AutomationId="ItemCheckBox"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      Click="ItemCheckBox_Click"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Border Background="#F4F7FB" CornerRadius="5">
                                                <Grid>
                                                    <Path Width="52"
                                                          Height="66"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#9BAABD"
                                                          Stretch="Fill"
                                                          Data="M5,1 L34,1 L49,16 L49,63 L5,63 Z M34,1 L34,16 L49,16">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Path Width="70"
                                                          Height="54"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#E6A23C"
                                                          Stretch="Fill"
                                                          Data="M2,8 L29,8 L38,18 L78,18 L78,62 L2,62 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Image Margin="4" Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    <Border Width="34"
                                                            Height="34"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="#CC172033"
                                                            CornerRadius="17">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Width="12"
                                                              Height="14"
                                                              Margin="3,0,0,0"
                                                              Fill="White"
                                                              Stretch="Fill"
                                                              Data="M0,0 L12,7 L0,14 Z"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Name}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding SizeLabel}"
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="DropHint"
                                Margin="20"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#F2F7FF"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="Drop files or folders to copy them here"/>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3"
                        Padding="18,12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock x:Name="OperationStatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Ready"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
