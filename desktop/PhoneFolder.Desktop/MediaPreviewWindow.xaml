<Window x:Class="PhoneFolder.Desktop.MediaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Transfer"
        Icon="Assets/PhoneTransfer.ico"
        Width="980"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        Background="#101827"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="MediaSurface"
              Background="#101827"
              MouseLeftButtonDown="MediaSurface_MouseLeftButtonDown">
            <Grid x:Name="RotatableSurface"
                  Margin="18"
                  RenderTransformOrigin="0.5,0.5">
                <Image x:Name="Photo"
                       MouseWheel="Photo_MouseWheel"
                       RenderTransformOrigin="0.5,0.5"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              ScrubbingEnabled="True"
                              Stretch="Uniform"
                              MediaOpened="Player_MediaOpened"
                              MediaEnded="Player_MediaEnded"
                              Visibility="Collapsed"/>
                <StackPanel x:Name="AudioPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Image Width="120" Height="120" Source="Assets/PhoneTransfer.png"/>
                    <TextBlock Margin="0,20,0,0"
                               FontSize="24"
                               Foreground="White"
                               Text="Audio from phone"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Button x:Name="CenterPlayButton"
                    Width="112"
                    Height="58"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="CenterPlayButton_Click"
                    Content="Play / Pause"
                    Style="{StaticResource PrimaryButton}"
                    Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="1" Padding="18,12" Background="#17233A">
            <StackPanel>
                <Grid x:Name="SeekPanel" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText"
                               VerticalAlignment="Center"
                               Foreground="#D9E5F5"
                               Text="0:00"/>
                    <Slider x:Name="SeekSlider"
                            Grid.Column="1"
                            Margin="8,0"
                            IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"/>
                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#D9E5F5"
                               Text="0:00"/>
                </Grid>

                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel x:Name="ImageControls"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Button x:Name="PreviousButton"
                                Click="PreviousButton_Click"
                                Content="Previous"/>
                        <Button x:Name="NextButton"
                                Click="NextButton_Click"
                                Content="Next"/>
                        <Button Click="ZoomOutButton_Click" Content="Zoom out"/>
                        <TextBlock x:Name="ZoomText"
                                   Width="58"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   Text="100%"
                                   TextAlignment="Center"/>
                        <Button Click="ZoomInButton_Click" Content="Zoom in"/>
                        <Button Click="ResetZoomButton_Click" Content="Reset"/>
                    </StackPanel>
                    <StackPanel x:Name="PlaybackControls"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Button Click="PlayButton_Click" Content="Play here"/>
                        <Button Click="PauseButton_Click" Content="Pause"/>
                        <Button Click="StopButton_Click" Content="Stop"/>
                    </StackPanel>
                    <Button Click="RotateButton_Click" Content="Rotate"/>
                    <Button x:Name="FullScreenButton"
                            Click="FullScreenButton_Click"
                            Content="Full screen"/>
                    <Button x:Name="DefaultAppButton"
                            Click="OpenDefaultButton_Click"
                            Content="Open in default app"
                            Style="{StaticResource PrimaryButton}"/>
                </WrapPanel>

                <TextBlock x:Name="StatusText"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#D9E5F5"
                           Text="Streaming directly from the phone"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
