<Window x:Class="PhoneFolder.Desktop.TrustedDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trusted phones"
        Icon="Assets/PhoneTransfer.ico"
        Width="590"
        Height="410"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Trusted phones"/>
            <TextBlock Margin="0,5,0,14"
                       Foreground="{StaticResource MutedBrush}"
                       Text="These phones can reconnect without entering the current Android access code."/>
        </StackPanel>
        <DataGrid x:Name="ProfilesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Style="{StaticResource CompactDataGrid}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="70" Header="Enabled">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Click="EnabledCheckBox_Click"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*" Binding="{Binding DeviceName}" Header="Phone" IsReadOnly="True"/>
                <DataGridTextColumn Width="120" Binding="{Binding Host}" Header="Address" IsReadOnly="True"/>
                <DataGridTextColumn Width="135" Binding="{Binding LastConnectedLabel}" Header="Last used" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Click="CloseButton_Click" Content="Close"/>
            <Button Click="RemoveSelectedButton_Click" Content="Remove selected"/>
            <Button Click="RemoveAllButton_Click" Content="Remove all"/>
        </DockPanel>
    </Grid>
</Window>
