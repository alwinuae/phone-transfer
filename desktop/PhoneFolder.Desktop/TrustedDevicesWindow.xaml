<Window x:Class="PhoneFolder.Desktop.TrustedDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trusted phones"
        Icon="Assets/PhoneTransfer.ico"
        Width="720"
        Height="440"
        MinWidth="580"
        MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Trusted phones"/>
            <TextBlock Margin="0,5,0,14"
                       Foreground="{StaticResource MutedBrush}"
                       Text="These phones can reconnect without entering the current Android access code."/>
        </StackPanel>
        <DataGrid x:Name="ProfilesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding DeviceName}" Header="Phone"/>
                <DataGridTextColumn Width="150" Binding="{Binding Host}" Header="Last address"/>
                <DataGridTextColumn Width="180" Binding="{Binding LastConnectedLabel}" Header="Last connected"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Click="CloseButton_Click" Content="Close"/>
            <Button Click="RemoveSelectedButton_Click" Content="Remove selected"/>
            <Button Click="RemoveAllButton_Click" Content="Remove all"/>
        </DockPanel>
    </Grid>
</Window>
