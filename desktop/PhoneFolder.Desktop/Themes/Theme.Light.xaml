<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light counterpart of Theme.Dark.xaml, matching the same surface hierarchy and contrast rules. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F6F7"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#ECEDEE"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#F1F2F3"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#E9EAEB"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#DBDDDF"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#CCCFD1"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#EFF0F1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E9E44"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#278A3A"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#2E8F73"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C1E1F"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6164"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9AA0A2"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D8DA"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#CFE9C8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>

    <!-- Promoted from previously-inline hardcoded colors so they can vary by theme. -->
    <SolidColorBrush x:Key="FileIconBrush" Color="#8C9294"/>
    <SolidColorBrush x:Key="FolderIconBrush" Color="#D99A3E"/>
    <SolidColorBrush x:Key="VideoBadgeBrush" Color="#CC181A1B"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#B9BDBF"/>
    <SolidColorBrush x:Key="ButtonDisabledBorderBrush" Color="#D8DADC"/>
    <SolidColorBrush x:Key="NavigationButtonBrush" Color="#ECEDEE"/>
    <SolidColorBrush x:Key="NavigationButtonBorderBrush" Color="#C7C9CB"/>
    <SolidColorBrush x:Key="DisconnectedButtonBrush" Color="#F7E2E2"/>
    <SolidColorBrush x:Key="DisconnectedButtonBorderBrush" Color="#D99B9B"/>
    <SolidColorBrush x:Key="DisconnectedButtonTextBrush" Color="#A23B3B"/>
    <SolidColorBrush x:Key="ConnectedDisconnectButtonBrush" Color="#FBE4E4"/>
    <SolidColorBrush x:Key="ConnectedDisconnectButtonTextBrush" Color="#B03B3B"/>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#E1E3E4"/>
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#F5F6F7"/>
    <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#ECEDEE"/>
    <SolidColorBrush x:Key="CutPendingBrush" Color="#DDEBD9"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#EFF2EE"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C7CACC"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A9ACAE"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E7E9EA"/>
</ResourceDictionary>
