<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PhoneTransfer</AssemblyName>
    <RootNamespace>PhoneFolder.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PhoneTransfer.ico</ApplicationIcon>
    <Version>0.7.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Phone Transfer</AssemblyTitle>
    <Product>Phone Transfer</Product>
    <Authors>Alwin Thomas</Authors>
    <Company>Alwin Thomas</Company>
    <Description>Wireless Android file browser and transfer client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PhoneTransfer.ico"/>
    <Resource Include="Assets\PhoneTransfer.png"/>
  </ItemGroup>

</Project>
