<Window x:Class="PhoneFolder.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Transfer setup"
        Icon="/PhoneTransfer;component/Assets/PhoneTransfer.ico"
        Style="{StaticResource {x:Type Window}}"
        Width="520"
        Height="420"
        MinWidth="460"
        MinHeight="400"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Setup"/>
            <TextBlock Margin="0,5,0,18"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Choose how files open from your phone."/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Padding="18"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <CheckBox x:Name="DefaultApplicationCheckBox"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Content="Always open files in the Windows default application"/>
                    <TextBlock Margin="24,10,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="Applies to Word, Excel, PDF, JPG/JPEG, PNG, audio, video, and other registered file types. Documents and images use a temporary local cache; video and audio stream directly when supported."/>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="18"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Theme"/>
                    <TextBlock Margin="0,4,0,10"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="Choose Dark, Light, or match your Windows setting."/>
                    <ComboBox x:Name="ThemeCombo" DisplayMemberPath="DisplayName"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button IsCancel="True" Content="Cancel"/>
            <Button Click="SaveButton_Click"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
