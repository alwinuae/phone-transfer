<Window x:Class="PhoneFolder.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Transfer setup"
        Icon="/PhoneTransfer;component/Assets/PhoneTransfer.ico"
        Style="{StaticResource {x:Type Window}}"
        Width="520"
        Height="300"
        MinWidth="460"
        MinHeight="280"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Setup"/>
            <TextBlock Margin="0,5,0,18"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Choose how files open from your phone."/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <CheckBox x:Name="DefaultApplicationCheckBox"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Content="Always open files in the Windows default application"/>
                <TextBlock Margin="24,10,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Applies to Word, Excel, PDF, JPG/JPEG, PNG, audio, video, and other registered file types. Documents and images use a temporary local cache; video and audio stream directly when supported."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button IsCancel="True" Content="Cancel"/>
            <Button Click="SaveButton_Click"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
