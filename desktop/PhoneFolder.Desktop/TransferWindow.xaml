<Window x:Class="PhoneFolder.Desktop.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Transfer - Transfers"
        Icon="Assets/PhoneTransfer.ico"
        Width="1080"
        Height="430"
        MinWidth="820"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Transfers"/>
            <TextBlock Margin="0,4,0,14"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Uploads and downloads continue while you browse or use another phone."/>
        </StackPanel>
        <DataGrid x:Name="JobsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Style="{StaticResource CompactDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="135" Binding="{Binding DeviceName}" Header="Phone"/>
                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Item"/>
                <DataGridTextColumn Width="90" Binding="{Binding Direction}" Header="Direction"/>
                <DataGridTextColumn Width="150" Binding="{Binding Location}" Header="Location"/>
                <DataGridTextColumn Width="90" Binding="{Binding SizeLabel}" Header="Size"/>
                <DataGridTemplateColumn Width="170" Header="Progress">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Height="18"
                                         Margin="3,1"
                                         Maximum="100"
                                         Tag="{Binding Progress, StringFormat={}{0:0}%}"
                                         Value="{Binding Progress, Mode=OneWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="90" Binding="{Binding Speed}" Header="Speed"/>
                <DataGridTextColumn Width="80" Binding="{Binding Remaining}" Header="Remaining"/>
                <DataGridTextColumn Width="150" Binding="{Binding Status}" Header="Status"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Click="CloseButton_Click" Content="Close"/>
            <Button Click="CancelButton_Click" Content="Cancel selected"/>
            <Button Click="ClearButton_Click" Content="Clear completed"/>
        </DockPanel>
    </Grid>
</Window>
