<Window x:Class="PhoneFolder.Desktop.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Transfer - Transfers"
        Icon="/PhoneTransfer;component/Assets/PhoneTransfer.ico"
        Style="{StaticResource {x:Type Window}}"
        Width="1320"
        Height="430"
        MinWidth="980"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Transfers"/>
            <TextBlock Margin="0,4,0,14"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Uploads and downloads continue while you browse or use another phone."/>
        </StackPanel>
        <DataGrid x:Name="JobsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Style="{StaticResource CompactDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="120" Binding="{Binding DeviceName}" Header="Phone"/>
                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Item"/>
                <DataGridTextColumn Width="75" Binding="{Binding Direction}" Header="Direction"/>
                <DataGridTextColumn Width="120" Binding="{Binding Location}" Header="Location"/>
                <DataGridTextColumn Width="150" Binding="{Binding SentAtLabel}" Header="Sent"/>
                <DataGridTextColumn Width="75" Binding="{Binding SizeLabel}" Header="Size"/>
                <DataGridTemplateColumn Width="150" Header="Progress">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Height="18"
                                         Margin="3,1"
                                         Maximum="100"
                                         Tag="{Binding Progress, StringFormat={}{0:0}%}"
                                         Value="{Binding Progress, Mode=OneWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="80" Binding="{Binding Speed}" Header="Speed"/>
                <DataGridTextColumn Width="70" Binding="{Binding Remaining}" Header="Remaining"/>
                <DataGridTextColumn Width="120" Binding="{Binding Status}" Header="Status"/>
                <DataGridTemplateColumn Width="160" Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,4,0"
                                        Padding="6,2"
                                        Click="OpenFileButton_Click"
                                        Content="Open"
                                        IsEnabled="{Binding CanReveal}"
                                        Tag="{Binding}"/>
                                <Button Padding="6,2"
                                        Click="ShowInFolderButton_Click"
                                        Content="Show in folder"
                                        IsEnabled="{Binding CanReveal}"
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Click="CloseButton_Click" Content="Close"/>
            <Button Click="CancelButton_Click" Content="Cancel selected"/>
            <Button Click="ClearButton_Click" Content="Clear completed"/>
        </DockPanel>
    </Grid>
</Window>
